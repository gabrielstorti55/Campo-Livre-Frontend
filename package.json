{
  "name": "campo-livre-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "next dev",
    "dev:prototype": "cross-env NEXT_PUBLIC_APP_MODE=prototipo next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "deadcode": "knip --include files,dependencies",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run test:e2e:frontend",
    "test:e2e:frontend": "cross-env NEXT_PUBLIC_APP_MODE=integrado playwright test tests/e2e/frontend-mode.spec.ts",
    "test:e2e:prototype": "cross-env NEXT_PUBLIC_APP_MODE=prototipo playwright test --grep-invert @integrado",
    "test:e2e:prototype:auth": "cross-env NEXT_PUBLIC_APP_MODE=prototipo playwright test tests/e2e/prototype-mode.spec.ts tests/e2e/autenticacao-login.spec.ts tests/e2e/personal-account.spec.ts tests/e2e/authentication-account-security.spec.ts --grep-invert @dominio-prototipo",
    "test:e2e:ui": "cross-env NEXT_PUBLIC_APP_MODE=prototipo playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "npm run format:check && npm run lint && npm run deadcode && npm run typecheck && npm run test:unit && npm run test:e2e:frontend && npm run test:e2e:prototype:auth && npm run build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.575.0",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.11"
  },
  "description": "Frontend Next.js do CampoLivre"
}
