{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,not-found}.tsx",
    "tests/e2e/**/*.spec.ts",
    "playwright.config.ts",
    "next.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"],
  "ignore": [".next/**", "graphify-out/**"],
  "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
}
